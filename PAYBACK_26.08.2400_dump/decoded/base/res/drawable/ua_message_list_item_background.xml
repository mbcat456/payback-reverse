<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_hovered="true">
        <inset android:insetLeft="8.0dip" android:insetRight="8.0dip">
            <shape>
                <solid android:color="#1a000000" />
                <corners android:radius="16.0dip" />
            </shape>
        </inset>
    </item>
    <item android:state_selected="true">
        <inset android:insetLeft="8.0dip" android:insetRight="8.0dip">
            <shape>
                <solid android:color="#1a000000" />
                <corners android:radius="16.0dip" />
            </shape>
        </inset>
    </item>
    <item android:state_activated="true">
        <inset android:insetLeft="8.0dip" android:insetRight="8.0dip">
            <shape>
                <solid android:color="#1a000000" />
                <corners android:radius="16.0dip" />
            </shape>
        </inset>
    </item>
    <item app:ua_state_highlighted="true">
        <inset android:insetLeft="8.0dip" android:insetRight="8.0dip">
            <shape>
                <solid android:color="?colorSurfaceVariant" />
                <corners android:radius="16.0dip" />
            </shape>
        </inset>
    </item>
    <item>
        <ripple android:color="?colorControlHighlight">
            <item android:gravity="center" android:id="@android:id/mask">
                <inset android:insetLeft="8.0dip" android:insetRight="8.0dip">
                    <shape android:shape="rectangle">
                        <solid android:color="@android:color/white" />
                        <corners android:radius="16.0dip" />
                    </shape>
                </inset>
            </item>
        </ripple>
    </item>
</selector>
